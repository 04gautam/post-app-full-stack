<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">

  <title>Document</title>
</head>
<body class="bg-gray-300 ">

    <%- include('../partials/header') %>

  <div class="flex flex-col items-center justify-center min-h-screen">
  <div class="w-96 ring p-10 bg-white rounded-xl shadow-md ">
    <div class="mb-8 text-lg font-bold text-blue-600 border-b border-blue-400 pb-6">
      <p>Post App</p> 
    </div>
    <form action="/createpost" method="post">
    <div class="grid gap-5">
      <input class=" w-full p-3 w-full border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:outline-none" type="text" name="title" placeholder="Enter Title" required>
      <textarea class="w-full p-3 resize-none border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:outline-none" type="text" name="discription" placeholder="Enter discription" required></textarea>
        
      </div>
      <div class="mt-10 text-center flex justify-center ">
        <button class="items-center bg-blue-500 p-2 text-white rounded-lg hover:bg-blue-600" type="submit ">Create Post</button>
      </div>
    </form>
  </div>
  </div>
</body>
</html>